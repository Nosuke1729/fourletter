{
  "name": "fourletter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "update:dictionary": "bash scripts/update_dictionary.sh",
    "export:dictionary-firebase": "python3 scripts/export_firebase_catalog.py",
    "test:rules": "firebase emulators:exec --project demo-fourletter --only auth,database \"node --test tests/firebase-rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "12.19.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "firebase-tools": "15.32.0",
    "typescript": "5.6.3",
    "vite": "6.4.3"
  }
}
